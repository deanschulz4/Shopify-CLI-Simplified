{
  "name": "simplified-shopify-cli",
  "version": "0.1.3",
  "description": "Configurable store aliases and shortcuts for Shopify theme development",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "sshop": "bin/sshop.js",
    "sd": "bin/sd.js",
    "sp": "bin/sp.js",
    "sl": "bin/sl.js",
    "si": "bin/si.js",
    "spl": "bin/spl.js",
    "spa": "bin/spa.js",
    "sc": "bin/sc.js",
    "sf": "bin/sf.js",
    "lo": "bin/lo.js",
    "sstores": "bin/sstores.js",
    "sconfig": "bin/sconfig.js",
    "sinit": "bin/sinit.js",
    "simport": "bin/simport.js",
    "shelp": "bin/shelp.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/postinstall.js",
    "shell/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/sshop.js && node --check src/cli.js && node --check src/config.js && node --check src/commands.js && node --check scripts/postinstall.js",
    "postinstall": "node scripts/postinstall.js",
    "generate:pdf": "python3 scripts/generate-cheat-sheet.py",
    "prepack": "npm run check && npm test",
    "release:check": "npm run check && npm test && node scripts/check-package.js"
  },
  "keywords": [
    "shopify",
    "cli",
    "themes",
    "aliases"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanschulz4/Shopify-CLI-Simplified.git"
  },
  "homepage": "https://github.com/deanschulz4/Shopify-CLI-Simplified#readme",
  "bugs": {
    "url": "https://github.com/deanschulz4/Shopify-CLI-Simplified/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
